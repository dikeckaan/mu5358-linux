#!/bin/sh
# A boot that reached here is good (W2, docs/superpowers/plans/2026-11-02-updater-from-linux.md): boot/ok on the
# filesystem names this system's version and boot/tries goes back to 0, so boot/init keeps booting this tree. Run by
# mu5358-boot-ok (S99) 30 s after the services are up - mu300's boot-ok without the slot re-arm (misc is never
# written here: Linux stays the one-shot trial). A flat installation has no boot/ and nothing is written.
D=${MU5358_DISK:-/mnt/mu5358-disk}
V=$(head -n 1 "${MU5358_ETC:-/etc/mu5358}/version" 2>/dev/null)
sleep "${MU5358_BOOT_OK_DELAY:-30}"
[ -d "$D/boot" ] || exit 0
[ -n "$V" ] || V=unknown
# a fallback boot (boot/init took system.old after three boots of system without ok): this tree is the good one, so
# it becomes system for good and the tree that failed is kept as system.failed (renames of a bind-mounted directory
# are safe: the running system keeps its directory)
if [ "${MU5358_ROOT:-/}" -ef "$D/system.old" ]; then
    rm -rf "$D/system.failed"
    mv "$D/system" "$D/system.failed" && mv "$D/system.old" "$D/system" && sync &&
        logger -t mu5358-boot-ok "fallback boot made permanent: system.old is system again, the tree that failed is system.failed" ||
        logger -t mu5358-boot-ok "could not make the fallback permanent"
fi
printf '%s\n' "$V" > "$D/boot/ok.new" && mv "$D/boot/ok.new" "$D/boot/ok" && echo 0 > "$D/boot/tries" && sync ||
    { logger -t mu5358-boot-ok "could not write $D/boot/ok"; exit 1; }
logger -t mu5358-boot-ok "boot ok: $V (tries 0)"
