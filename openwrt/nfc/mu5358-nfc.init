#!/bin/sh /etc/rc.common
# U30 Pro: the NFC tag follows the hotspot (/opt/mu5358/bin/mu5358-nfc-sync). One sync at boot, one after a LuCI
# apply of the wireless configuration (the reload trigger); the AP's up/down and "wifi reload" have their own calls.
START=95
USE_PROCD=1

start_service() {
	procd_open_instance sync
	procd_set_param command /opt/mu5358/bin/mu5358-nfc-sync sync
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	/opt/mu5358/bin/mu5358-nfc-sync sync
}

service_triggers() {
	procd_add_reload_trigger wireless
}
