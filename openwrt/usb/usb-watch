#!/bin/sh
# Re-enumerate the USB gadget (usb_gadget/linux) while no host has it: after 30 s, then 60, 120, 240 and every 300 s,
# back to 30 once a host has it. With no cable that is one pullup toggle every 5 min. A host has it when the UDC is
# configured and the NCM link has a carrier: the vendor musb kept saying "configured" after the D+ pullup was off
# (2026-10-29), so the state alone is not enough.
#
# Patience (2026-11-01): a host that is enumerating takes its time - the Mac needed more than 20 s for the composite
# with a 16 GiB flash drive - and one re-enumeration in the middle of that starts it over, so the link never settled.
# A state is acted on only after it has lasted BAD_FOR seconds in a row, and never within GRACE seconds of a rebind
# the tools did on purpose (mu5358-usb and adbd write the uptime of their last bind to the stamp).
G=${MU5358_GADGET:-/sys/kernel/config/usb_gadget/linux}
UDC_CLASS=${MU5358_UDC_CLASS:-/sys/class/udc}
NETDEV=${MU5358_NETDEV:-/proc/net/dev}
UPTIME=${MU5358_UPTIME:-/proc/uptime}
USBTYPE=${MU5358_USBTYPE:-/sys/class/power_supply/battery/usb_type}
STAMP=${MU5358_REBOUND:-/run/mu5358/usb-rebound}
LEASES=${MU5358_LEASES:-/tmp/dhcp.leases}
BAD_FOR=${MU5358_BAD_FOR:-60}
GRACE=${MU5358_GRACE:-90}
gap=30
sleep 30
bad_since=
while :; do
	udc=$(cat $G/UDC 2>/dev/null)
	st=$(cat $UDC_CLASS/$udc/state 2>/dev/null)
	# usb0 by name: reading the NCM function's ifname takes the RTNL lock
	ifc=usb0
	# the carrier from the link flags: after a rebind of the controller usb0 lives on with its sysfs directory gone
	car=0; ip -o link show "${ifc:-usb0}" 2>/dev/null | grep -q LOWER_UP && car=1
	# a link whose sending side died (2026-10-30: the Mac's DHCP requests kept coming, usb0 sent nothing for minutes,
	# the Mac sat at 169.254): our TX still for 60 s while RX grew by 3 packets or more. Counters from /proc/net/dev,
	# which the rebind leaves working.
	set -- $(awk -v i="${ifc:-usb0}:" '$1 == i { print $3, $11 }' $NETDEV)
	rx=${1:-0}; tx=${2:-0}; t=$(cut -d. -f1 $UPTIME); stalled=0
	if [ "$tx" != "${last_tx:-}" ]; then
		last_tx=$tx; ref_t=$t; ref_rx=$rx
	elif [ $((t - ref_t)) -ge 60 ] && [ $((rx - ref_rx)) -ge 3 ]; then
		stalled=1
	fi
	if [ $stalled = 1 ]; then
		# a dead sender, or a link with nothing to say (2026-11-01: the Mac's mDNS kept RX growing for a minute after
		# boot while the device owed it nothing, and a working link was cut)? One ping to the host (its DHCP lease):
		# a sender that works moves the TX counter.
		host=$(awk 'NR == 1 { print $3 }' "$LEASES" 2>/dev/null)
		[ -z "$host" ] || ping -c 1 -W 1 "$host" >/dev/null 2>&1
		set -- $(awk -v i="${ifc:-usb0}:" '$1 == i { print $3, $11 }' $NETDEV)
		if [ "${2:-0}" != "$tx" ]; then stalled=0; last_tx=${2:-0}; ref_t=$t; ref_rx=${1:-0}; fi
	fi
	if [ -z "$udc" ] || { [ "$st" = configured ] && [ "$car" = 1 ] && [ $stalled = 0 ]; }; then
		gap=30; bad_since=
		sleep 10
		continue
	fi
	# a rebind done on purpose a moment ago: the host is enumerating, leave it be
	case $(cat "$STAMP" 2>/dev/null) in
		''|*[!0-9]*) ;;
		*) if [ $((t - $(cat "$STAMP"))) -lt $GRACE ]; then bad_since=; sleep 10; continue; fi ;;
	esac
	# the bad state has to last: one sample in the middle of a host's enumeration is not a dead link
	[ -n "$bad_since" ] || bad_since=$t
	if [ $((t - bad_since)) -lt $BAD_FOR ]; then sleep 10; continue; fi
	[ $stalled = 1 ] && st="$st, sending stalled"
	# a host on the port (a data port: SDP or CDP), else a charger or nothing, and nobody to enumerate with
	case $(cat $USBTYPE 2>/dev/null) in
		*"[SDP]"*|*"[CDP]"*) ;;
		*) sleep 10; continue ;;
	esac
	# Only the gadget's own rebind: a rebind of the controller (musb-sprd unbind/bind, tried on 2026-10-30) leaves
	# usb0 with its parent device gone, and the next rtnl_fill_ifinfo oopsed on it holding the RTNL lock - every
	# network command hung from then on
	logger -t mu5358-usb "gadget $st (carrier ${car:-none}) on $udc: re-enumerating, next try in ${gap}s"
	# off for 5 s: long enough for a host's hub to see the device gone
	echo "" > $G/UDC 2>/dev/null
	sleep 5
	echo "$udc" > $G/UDC 2>/dev/null || logger -t mu5358-usb "could not bind $udc again"
	last_tx=; bad_since=
	sleep $gap
	[ $gap -ge 300 ] || gap=$((gap * 2))
	[ $gap -le 300 ] || gap=300
done
