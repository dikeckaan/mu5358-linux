# U30 Pro (UMS9632) mainline, stage 2: the kernel starts on the stock vendor DTB, logs into ramoops (the DTB's
# ramoops@fff80000) and into the bootloader's minidump (patches/0003); with no init it panics and halts (panic=0)
# until the PMIC watchdog resets it as abnormal, and LK saves the minidump to sysdumpdb. Merged over allnoconfig.
CONFIG_64BIT=y
CONFIG_ARCH_SPRD=y
CONFIG_ARM64_4K_PAGES=y
CONFIG_SMP=y
CONFIG_NR_CPUS=8
CONFIG_RELOCATABLE=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_OF=y
CONFIG_MISC_FILESYSTEMS=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_SPI=y
CONFIG_SPI_SPRD_ADI=y
CONFIG_HWSPINLOCK=y
CONFIG_HWSPINLOCK_SPRD=y
CONFIG_ARM_PSCI_FW=y
CONFIG_CMDLINE="loglevel=8 log_buf_len=1M printk.devkmsg=on panic=0 rdinit=/mlinit sdhci_sprd.r11p3_mode=hs400 clk_ignore_unused pd_ignore_unused regulator_ignore_unused fw_devlink=permissive"
CONFIG_CMDLINE_FORCE=y
CONFIG_SPRD_MINIDUMP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_RD_LZ4=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_POSIX_TIMERS=y
CONFIG_UNIX=y
CONFIG_NET=y
CONFIG_INITRAMFS_SOURCE="/work/initramfs/list"
CONFIG_COMMON_CLK=y
CONFIG_SPRD_UMS9632_BRINGUP_CLK=y
CONFIG_BLOCK=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BLOCK_MINORS=256
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_SPRD=y
CONFIG_DEBUG_FS=y
# the other Spreadtrum SoCs' clock drivers (on by default with ARCH_SPRD)
CONFIG_SPRD_SC9860_CLK=n
CONFIG_SPRD_SC9863A_CLK=n
CONFIG_SPRD_UMS512_CLK=n
# USB gadget on the MUSB (patches/0006), PIO; NCM + ACM over configfs, a network for telnet
CONFIG_USB_SUPPORT=y
CONFIG_USB_GADGET=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_GADGET=y
# the USB block's gate and resets come from patches/0004 (it faults unclocked: ml6 2026-10-29)
CONFIG_USB_MUSB_SPRD=y
CONFIG_MUSB_PIO_ONLY=y
CONFIG_CONFIGFS_FS=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_NETDEVICES=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
# the USB PHY (patches/0008): power, isolation, 16-bit UTMI, device mode, VBUS valid forced
CONFIG_MFD_SYSCON=y
CONFIG_USB_PHY=y
CONFIG_USB_SPRD_UMS9632_PHY=y
CONFIG_DEVMEM=y
