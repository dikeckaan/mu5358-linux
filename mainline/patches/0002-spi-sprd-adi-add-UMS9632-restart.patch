spi: sprd-adi: add UMS9632 (UMP9650 PMIC) restart

The UMS9632 has the ADI controller of the UMS9620 with a UMP9650 PMIC, which resets through the same
software reset path at other register addresses: RST_STATUS 0x21d4 and SWRST_CTRL0 0x2220 (SOFT_RST_HW 0x2024
is shared), as the ums9632_data of the vendor spi-sprd-adi.ko has them. The UMS9620 restart becomes a helper
taking the two addresses. Power-off is left to PSCI until the UMP9650 sequence is known.

--- a/drivers/spi/spi-sprd-adi.c	2026-10-29 12:07:43.093008007 +0000
+++ b/drivers/spi/spi-sprd-adi.c	2026-10-29 12:07:43.102959632 +0000
@@ -118,6 +118,9 @@
 #define UMP9620_BIT_LDO_XTL_EN		BIT(2)
 #define UMP9620_BIT_SLP_LDO_PD_EN	BIT(0)
 #define UMP9620_BIT_PWR_OFF_EN		BIT(0)
+/* UMP9650 PMIC (UMS9632): the same reset path at other addresses (the vendor driver's ums9632_data) */
+#define UMP9650_RST_STATUS		0x21d4
+#define UMP9650_SWRST_CTRL0		0x2220
 
 /* Definition of PMIC reset status register */
 #define HWRST_STATUS_SECURITY		0x02
@@ -472,7 +475,7 @@
 	return sprd_adi_restart(data->cb_data, data->mode, data->cmd, &wdg);
 }
 
-static int sprd_adi_restart_ums9620(struct sys_off_data *data)
+static int sprd_adi_restart_softrst(struct sys_off_data *data, u32 rst_status, u32 swrst_ctrl0)
 {
 	struct sprd_adi *sadi = data->cb_data;
 	u32 val, reboot_mode = HWRST_STATUS_NORMAL;
@@ -482,13 +485,13 @@
 	else if (data->cmd && !strncmp(data->cmd, "panic", 5))
 		reboot_mode = HWRST_STATUS_PANIC;
 
-	sprd_adi_read(sadi, UMP9620_RST_STATUS, &val);
+	sprd_adi_read(sadi, rst_status, &val);
 	val &= ~0xff;
 	val |= reboot_mode;
-	sprd_adi_write(sadi, UMP9620_RST_STATUS, val);
+	sprd_adi_write(sadi, rst_status, val);
 
-	sprd_adi_read(sadi, UMP9620_SWRST_CTRL0, &val);
-	sprd_adi_write(sadi, UMP9620_SWRST_CTRL0, val | UMP9620_BIT_RST_EN);
+	sprd_adi_read(sadi, swrst_ctrl0, &val);
+	sprd_adi_write(sadi, swrst_ctrl0, val | UMP9620_BIT_RST_EN);
 
 	sprd_adi_read(sadi, UMP9620_SOFT_RST_HW, &val);
 	sprd_adi_write(sadi, UMP9620_SOFT_RST_HW, val | UMP9620_BIT_SOFT_RST);
@@ -499,6 +502,16 @@
 	return NOTIFY_DONE;
 }
 
+static int sprd_adi_restart_ums9620(struct sys_off_data *data)
+{
+	return sprd_adi_restart_softrst(data, UMP9620_RST_STATUS, UMP9620_SWRST_CTRL0);
+}
+
+static int sprd_adi_restart_ums9632(struct sys_off_data *data)
+{
+	return sprd_adi_restart_softrst(data, UMP9650_RST_STATUS, UMP9650_SWRST_CTRL0);
+}
+
 /* PSCI SYSTEM_OFF does not return on this firmware either; the PMIC switches the system off */
 static int sprd_adi_power_off_ums9620(struct sys_off_data *data)
 {
@@ -696,6 +709,14 @@
 	.power_off = sprd_adi_power_off_ums9620,
 };
 
+/* the same controller with the UMP9650; power-off is not known for it yet and stays PSCI's */
+static struct sprd_adi_data ums9632_data = {
+	.slave_offset = ADI_15BIT_SLAVE_OFFSET,
+	.slave_addr_size = ADI_15BIT_SLAVE_ADDR_SIZE,
+	.restart = sprd_adi_restart_ums9632,
+	.restart_prio = SYS_OFF_PRIO_HIGH,
+};
+
 static const struct of_device_id sprd_adi_of_match[] = {
 	{
 		.compatible = "sprd,sc9860-adi",
@@ -718,6 +739,10 @@
 		.compatible = "sprd,qogirn6pro-adi",
 		.data = &ums9620_data,
 	},
+	{
+		.compatible = "sprd,ums9632-adi",
+		.data = &ums9632_data,
+	},
 	{ },
 };
 MODULE_DEVICE_TABLE(of, sprd_adi_of_match);
