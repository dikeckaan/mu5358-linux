-		rst = devm_reset_control_get_optional_shared_deasserted(dev, resets[i]);
-		if (IS_ERR(rst)) {
-			ret = sprd_musb_skip(dev, PTR_ERR(rst), resets[i]);
-			if (ret)
-				return ret;
-		}
-	}
-
