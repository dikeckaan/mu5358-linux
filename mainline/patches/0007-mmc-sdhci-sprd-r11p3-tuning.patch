+/*
+ * R11P3 (UMS9632) eMMC tuning, after the Unisoc vendor driver: this host has
+ * no SDHCI standard tuning (Execute Tuning never completes, so sdhci's own
+ * tuning silently times out and leaves an untuned sampling point). Instead,
+ * with the DLL compensation (DLL_CFG bits 27:24) off, DLL_DLY's command and
+ * positive-edge read delays are in raw DLL steps: sweep them over 1.5 clock
+ * periods sending the tuning command, take the middle of the longest window
+ * that passes (a step passes only if the same step one period later passes
+ * too), turn compensation back on and program that step as a phase in
+ * 1/256 of a period.
+ */
+static int sdhci_sprd_r11p3_execute_tuning(struct mmc_host *mmc, u32 opcode)
+{
+	struct sdhci_host *host = mmc_priv(mmc);
+	struct sdhci_sprd_host *sprd_host = TO_SPRD_HOST(host);
+	u32 *p = sprd_host->phy_delay;
+	unsigned int timing = mmc->ios.timing;
+	u32 dll_cfg, dll_sts0, dll_cnt, dll_dly, length, i;
+	int best_start = -1, best_len = 0, start = -1, len = 0, npass = 0;
+	unsigned int mid_step, phase;
+	bool hs400_tuning;
+	u8 *value, *ok;
+	int err = 0;
+
+	hs400_tuning = host->flags & SDHCI_HS400_TUNING;
+	host->flags &= ~SDHCI_HS400_TUNING;
+
+	/* HS400 is tuned in HS200; its delays then come from the device tree */
+	if (timing == MMC_TIMING_MMC_HS400)
+		return -EINVAL;
+	if (timing >= ARRAY_SIZE(sprd_host->phy_delay))
+		return -EINVAL;
+
+	sdhci_reset(host, SDHCI_RESET_CMD | SDHCI_RESET_DATA);
+
+	dll_cfg = sdhci_readl(host, SDHCI_SPRD_REG_32_DLL_CFG);
+	dll_cfg &= ~SDHCI_SPRD_CPST_EN;
+	sdhci_writel(host, dll_cfg, SDHCI_SPRD_REG_32_DLL_CFG);
+
+	dll_sts0 = sdhci_readl(host, SDHCI_SPRD_REG_32_DLL_STS0);
+	/* DLL steps per card clock period */
+	dll_cnt = (dll_sts0 & SDHCI_SPRD_DLL_COUNT_MASK) << 1;
+	length = dll_cnt * 3 / 2;
+	dev_info(mmc_dev(mmc), "r11p3 tuning: timing %u%s opcode %u clock %u: dll cfg %#010x sts0 %#010x, dll count %u, tuning length %u\n",
+		 timing, hs400_tuning ? " (for hs400)" : "", opcode, host->clock,
+		 dll_cfg, dll_sts0, dll_cnt, length);
+	if (!(dll_sts0 & SDHCI_SPRD_DLL_LOCKED) || !dll_cnt) {
+		dev_err(mmc_dev(mmc), "r11p3 tuning: DLL not locked\n");
+		err = -EIO;
+		goto out_cpst;
+	}
+
+	value = kzalloc(length + 1 + dll_cnt, GFP_KERNEL);
+	if (!value) {
+		err = -ENOMEM;
+		goto out_cpst;
+	}
+	ok = value + length + 1;
+
+	dll_dly = p[timing];
+	for (i = 0; i <= length; i++) {
+		dll_dly &= ~(SDHCI_SPRD_CMD_DLY_MASK | SDHCI_SPRD_POSRD_DLY_MASK);
+		dll_dly |= FIELD_PREP(SDHCI_SPRD_CMD_DLY_MASK, i & 0xff) |
+			   FIELD_PREP(SDHCI_SPRD_POSRD_DLY_MASK, i & 0xff);
+		sdhci_writel(host, dll_dly, SDHCI_SPRD_REG_32_DLL_DLY);
+		value[i] = !mmc_send_tuning(mmc, opcode, NULL);
+		npass += value[i];
+	}
+
+	/* one period, a step passes if it passes one period later too */
+	for (i = 0; i < dll_cnt; i++)
+		ok[i] = value[i] && (i + dll_cnt > length || value[i + dll_cnt]);
+
+	/* longest window, circular over the period */
+	for (i = 0; i < 2 * dll_cnt && best_len < dll_cnt; i++) {
+		if (ok[i % dll_cnt]) {
+			if (!len)
+				start = i;
+			len++;
+			if (len > best_len) {
+				best_len = len;
+				best_start = start;
+			}
+		} else {
+			len = 0;
+		}
+	}
+	best_len = min_t(int, best_len, dll_cnt);
+
+	{
+		char map[257];
+		u32 n = min_t(u32, length + 1, sizeof(map) - 1);
+
+		for (i = 0; i < n; i++)
+			map[i] = value[i] ? '+' : '.';
+		map[n] = 0;
+		dev_info(mmc_dev(mmc), "r11p3 tuning: steps 0..%u: %s\n", n - 1, map);
+	}
+
+	if (!best_len) {
+		dev_err(mmc_dev(mmc), "r11p3 tuning: all %u steps fail (%d single passes)\n",
+			length + 1, npass);
+		kfree(value);
+		err = -EIO;
+		goto out_cpst;
+	}
+
+	mid_step = (best_start + best_len / 2) % dll_cnt;
+	phase = mid_step * 256 / dll_cnt;
+	p[timing] &= ~(SDHCI_SPRD_CMD_DLY_MASK | SDHCI_SPRD_POSRD_DLY_MASK);
+	p[timing] |= FIELD_PREP(SDHCI_SPRD_CMD_DLY_MASK, phase) |
+		     FIELD_PREP(SDHCI_SPRD_POSRD_DLY_MASK, phase);
+
+	dev_info(mmc_dev(mmc), "r11p3 tuning: best window %d-%d (length %d of %u), step %u, phase %#04x, delay value %#010x\n",
+		 best_start % dll_cnt, (best_start + best_len - 1) % dll_cnt,
+		 best_len, dll_cnt, mid_step, phase, p[timing]);
+	kfree(value);
+
+out_cpst:
+	dll_cfg |= SDHCI_SPRD_CPST_EN;
+	sdhci_writel(host, dll_cfg, SDHCI_SPRD_REG_32_DLL_CFG);
+	sdhci_writel(host, p[timing], SDHCI_SPRD_REG_32_DLL_DLY);
+
+	return err;
+}
